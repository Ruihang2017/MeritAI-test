# Copy to .env and fill in. .env is gitignored; this example file is committed.

# OpenAI API key for voice mode (/voice). Use a company key.
# Not named OPENAI_API_KEY on purpose: that variable makes `npm run login`
# switch the Codex engine to API-key billing.
VOICE_OPENAI_API_KEY=

# GPT-Live model and voice.
VOICE_MODEL=gpt-live-1
VOICE_NAME=gleam

# Sending from Gmail (src/email/gmail.ts): a Google OAuth client of type Desktop app, with the gmail.send scope.
# The desktop build (scripts/build-desktop.mjs) builds these into the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
