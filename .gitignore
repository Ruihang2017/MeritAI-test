node_modules/
# Everything codex writes into its home except our config and our skills:
# credentials, sessions, caches, sqlite state, Codex's own system skills.
codex_home/*
!codex_home/config.toml
!codex_home/skills/
codex_home/skills/.system/
/workspace/*
# Per-user runtime memory (preferences, work notes, session index).
/memory/
# Local secrets
.env
# User files (Plan A default location)
/files/
# Evaluation results (synthetic data; large)
eval/results/
# Crash dumps from Git Bash
*.stackdump
# Agent worktrees
.claude/worktrees/
/web/dist/
/workspace-demo/
/memory-demo/

# Test suites, evals and experiments (scripts/testHome.ts): its own sign-in and conversations.
/codex_home_test/
/dist-desktop/
/release/
/files (sample)/
