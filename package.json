{
  "name": "fx-chatbot",
  "version": "0.2.1",
  "private": true,
  "description": "Office chatbot CLI on top of a locally hosted codex app-server",
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "login": "tsx src/cli.ts --login",
    "login:test": "tsx scripts/login-test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "gen:protocol": "codex app-server generate-ts --experimental --out src/protocol",
    "e2e": "tsx scripts/e2e.ts",
    "inspect": "tsx scripts/inspect.ts",
    "ab:base": "tsx scripts/ab-base.ts",
    "ab:tier": "tsx scripts/ab-tier.ts",
    "test:skills": "tsx scripts/skills-test.ts",
    "test:memory": "tsx scripts/memory-test.ts",
    "test:research": "tsx scripts/research-test.ts",
    "test:files": "tsx scripts/files-test.ts",
    "test:hr": "tsx scripts/hr-test.ts",
    "test:voice": "tsx scripts/voice-test.ts",
    "test:screening": "tsx scripts/screening-test.ts",
    "test:business": "tsx scripts/business-test.ts",
    "test:hiring": "tsx scripts/hiring-test.ts",
    "test:register": "tsx scripts/register-test.ts",
    "test:reminders": "tsx scripts/reminders-test.ts",
    "test:award": "tsx scripts/award-test.ts",
    "test:unit": "tsx scripts/unit-test.ts",
    "eval": "tsx eval/run.ts",
    "eval:report": "tsx eval/report.ts",
    "eval:compare": "tsx eval/compare.ts",
    "ui": "tsx src/server/main.ts",
    "ui:demo": "tsx src/server/main.ts --demo",
    "ui:fake": "tsx src/server/main.ts --fake",
    "ui:build": "vite build web",
    "ui:dev": "tsx src/server/main.ts --dev --fake",
    "desktop:build": "vite build web && node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@openai/codex": "^0.156.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "docx": "^9.7.2",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1",
    "ws": "^8.21.3"
  },
  "main": "dist-desktop/main.mjs",
  "build": {
    "appId": "au.meritai.desktop",
    "productName": "MeritAI",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist-desktop/**",
      "web/dist/**",
      "prompts/**",
      "codex_home/config.toml",
      "codex_home/skills/**",
      "!codex_home/skills/.system/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc",
        "to": "codex"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MeritAI"
    }
  }
}
